{
  "name": "youtube-ai-factory",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "check:async-boundaries": "node scripts/check-async-error-boundaries.mjs",
    "check:docs": "node scripts/check-docs-source-of-truth.mjs",
    "check:auth-coverage": "node scripts/check-auth-coverage.mjs",
    "check:no-write-in-get": "node scripts/check-no-write-in-get.mjs",
    "check:actor-separation": "node scripts/check-actor-separation.mjs",
    "check:migration-safety": "node scripts/check-migration-safety.mjs",
    "check:gate-status": "node scripts/check-gate-status.mjs",
    "check:docs-growth": "node scripts/check-docs-growth.mjs",
    "check:legacy-shrink": "node scripts/check-legacy-shrink.mjs",
    "check:dependency-audit": "node scripts/check-dependency-audit.mjs",
    "verify:deployment-tree": "node --import tsx scripts/verify-exact-tree-deployment.mjs",
    "check:candidate-policy": "npm run check:auth-coverage && npm run check:no-write-in-get && npm run check:actor-separation && npm run check:migration-safety && npm run check:gate-status && npm run check:docs-growth && npm run check:legacy-shrink",
    "check:commercial-ui": "node scripts/check-commercial-ui.mjs",
    "check:commercial-primary": "node --import tsx scripts/check-commercial-primary.ts",
    "check:intelligence-niche-contract": "node --import tsx scripts/check-intelligence-niche-contract.ts",
    "check:niche-portfolio-v2": "node --import tsx scripts/check-niche-opportunity-portfolio-v2.ts",
    "check:channel-strategy-bootstrap": "node --import tsx scripts/check-canonical-channel-strategy-bootstrap.ts",
    "check:content-planning": "node --import tsx scripts/check-content-system-planning.ts",
    "check:production-v2-firewall": "node scripts/check-production-v2-firewall.mjs",
    "check:projection-integrity": "node scripts/check-projection-integrity.mjs",
    "check:commercial-rendered": "node scripts/check-commercial-rendered.mjs",
    "check:commercial-performance": "node scripts/check-commercial-performance.mjs",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --import tsx --test tests/*.test.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "media:executor": "node scripts/media-executor.mjs",
    "golden:master:executor": "node --import tsx scripts/golden-master-executor.ts",
    "golden:audience:executor": "node scripts/audience-golden-executor.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "jpeg-js": "^0.4.4",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "YouTube AI Factory"
}
